[Unit]
Description=Postmark crossing-save — crystallize the record into the world repo's STATE/
# The save tick is the town's existing heartbeat, not a new clock: the crossing
# IS the save. It reads the record — the walk ledger and the store's acts
# (departures, holdings, voices) — and writes STATE/snapshot/<N>/entities.json
# and STATE/log/<N>.jsonl into the world repo, committed with the office pen.
# dynamic.db is not opened (POS-269).
#
# NOT INSTALLED BY THIS BRANCH. Wright installs and enables after review:
#   sudo cp deploy/postmark-crossing-save.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now postmark-crossing-save.timer
After=network.target

[Service]
Type=oneshot
# Runs as the office user. The world clone is meepo's (root's git refuses it as
# "dubious ownership") and the pen's push credentials live in meepo's home. This
# User= line is load-bearing — the ferry unit shipped without it once and the
# first two scheduled crossings after cutover failed in git before the ferry
# ever ran.
User=meepo
EnvironmentFile=/etc/postmark-office.env
WorkingDirectory=/srv/postmark-office
# ONE FLOCK, THE SAME ONE. The ferry, the rehydrate tick and the office pen all
# serialize on town.lock — one writer at a time on the clones. A crossing-save
# that wrote STATE/ while the write pen had the world clone parked on a
# household draft branch would commit the town's memory onto a sketchbook; the
# walk ledger lost 17 public lines to exactly that class of race in 2026-07.
#
# --prune IS A NO-OP SINCE POS-269, and stays on the line on purpose: it pruned
# faded presence out of dynamic.db, which is retired, and the save accepts it
# and does nothing, so the installed unit and this file agree without a box
# step. Drop it at the next reinstall.
ExecStart=/usr/bin/flock -w 300 /srv/postmark-office/town.lock \
  /usr/bin/node /srv/postmark-office/tools/crossing-save.mjs --prune
# A failure here must be loud rather than absorbed: a save that cannot read the
# record refuses by name and writes nothing, and the missing crossing is only
# ever noticed by whoever reads this unit's status.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/postmark-office
PrivateTmp=yes
